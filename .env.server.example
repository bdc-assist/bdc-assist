# Server (docker) settings: copy to .env.server on the server; docker-compose.yml passes it in.
# Local dev keeps using .env (.env.example lists every variable).
# No empty value followed by a comment: dotenv parsers read `KEY=   # note` as "# note".

R_DOC_MCP_URL=http://doc-mcp:8001/mcp # the doc-mcp compose service; overrides mcp_servers.yaml's 127.0.0.1 url
CONFIG_DIR=examples/bdc               # the BDC bot: its prompts, predefined responses and MCP servers (adds dug_mcp)
CORS_ORIGINS=https://your-client-origin   # the web client's origin(s), comma-separated; not *

COMPLETION_MODEL_PROVIDER=openai      # openai|azure|vllm|ollama
COMPLETION_MODEL=gpt-4o-mini
# key for the provider above (azure falls back to it when AZURE_OPENAI_API_KEY is unset)
OPENAI_API_KEY=
# OPENAI_BASE_URL=                    # OpenAI-compatible gateway, if not api.openai.com
# COMPLETION_URL=                     # endpoint for azure/vllm/ollama providers
# AZURE_OPENAI_API_KEY=
# AZURE_API_VERSION=2024-10-21
# COMPLETION_TEMPERATURE=0
# COMPLETION_REASONING_EFFORT=        # see .env.example

# LOG_LEVEL=WARNING                   # WARNING already shows MCP servers going down and coming back
# MCP_RETRY_SECONDS=300

# Chats at once, and how many more may wait in line (told their place) before new ones get a 503.
# Measured 2026-10-21 (tests/loadtest.py chat) with query embeddings on the CPU-only remote Ollama, about
# 1 search/s: chats ran about as fast as one alone (~13 s) up to 10 at once, and 2.5x slower at 20.
# 30 waiting = at most ~40 s in line (a slot frees every ~1.3 s). Measure again when a backend changes.
MAX_RUNNING_CHATS=10
MAX_WAITING_CHATS=30
