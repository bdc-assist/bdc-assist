COMPLETION_MODEL_PROVIDER=openai      # openai|azure|vllm|ollama; inferred from COMPLETION_URL when unset
COMPLETION_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=                    # OpenAI-compatible gateway, if not api.openai.com
# COMPLETION_URL=                     # endpoint for azure/vllm/ollama providers
# AZURE_OPENAI_API_KEY=               # falls back to OPENAI_API_KEY
# AZURE_API_VERSION=2024-10-21
# COMPLETION_TEMPERATURE=0            # sampling temperature, every provider
# COMPLETION_REASONING_EFFORT=        # unset for gpt-4o/gpt-4o-mini; reasoning models (gpt-6-luna): none|low|medium|high
#                                     # above none: temperature not sent, Responses API (needed for tools while reasoning)

# CORS_ORIGINS=*                      # comma-separated browser origins allowed to call the API
# API_PORT=8010                       # r-assist API port used by demo_services.* and demo.ipynb
# LOG_LEVEL=WARNING                   # app log level: DEBUG|INFO|WARNING|ERROR
# MCP_RETRY_SECONDS=300               # how often unavailable MCP servers are retried and live ones re-checked
# DOC_MCP_DIR=../bdc-doc-mcp          # sibling r-doc-mcp checkout, started by demo_services.*
# START_TIMEOUT=30                    # seconds demo_services.* wait for each service to answer

# CONFIG_DIR=config                   # folder with the yaml files (project, prompts, predefined, mcp_servers); examples/bdc for the BDC bot, examples/fastapi for FastAPI
