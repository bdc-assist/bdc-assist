DOC_RAG_MCP_URL=http://127.0.0.1:8001/mcp

# Optional — unused with the defaults above:
# COMPLETION_URL=          # completion endpoint for azure/vllm/ollama providers (URL also infers the provider)
# AZURE_OPENAI_API_KEY=    # Azure key (falls back to OPENAI_API_KEY)
# AZURE_API_VERSION=2024-10-21
